# Nothing is required here to get started - Meta App ID/Secret are entered
# directly in the ManyMit web UI on first run (Settings screen), not here.

# --- Public tunnel (optional) ---
# Without these, ManyMit falls back to a free Cloudflare quick tunnel whose URL
# changes every restart. Get a free static domain at https://dashboard.ngrok.com
# (Domains -> New Domain) to keep the same URL forever.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
