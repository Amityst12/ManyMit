# --- Meta App (required) ---
# Create your own free app at https://developers.facebook.com/apps — see README.md
# for the exact click-path. This is YOUR app, so there's no review/approval step.
META_APP_ID=
META_APP_SECRET=

# Any secret string you make up yourself — Meta echoes it back to verify your webhook.
INSTAGRAM_VERIFY_TOKEN=

# --- Public tunnel (optional but recommended) ---
# Without these, ManyMit falls back to a free Cloudflare quick tunnel whose URL
# changes every restart. Get a free static domain at https://dashboard.ngrok.com
# (Domains -> New Domain) to keep the same URL forever.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
